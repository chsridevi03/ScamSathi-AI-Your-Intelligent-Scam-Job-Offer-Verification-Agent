# ScamSathi AI Environment Configuration
# NVIDIA x Nebius Global AI Hackathon

# Nebius Token Factory API Key (OpenAI-compatible)
NEBIUS_API_KEY=your_nebius_token_factory_api_key_here

# Nebius Base URL (default for Token Factory)
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1

# NVIDIA Nemotron Model Identifier on Nebius
# Supported models:
# - nvidia/nemotron-4-340b-instruct
# - nvidia/llama-3.1-nemotron-70b-instruct
NEBIUS_MODEL_ID=nvidia/nemotron-4-340b-instruct

# Tavily Search API Key for evidence-based real-time web retrieval
TAVILY_API_KEY=tvly-your_tavily_search_api_key_here

# Optional: Google Gemini API key for fallback inference / grounding
GEMINI_API_KEY=your_gemini_api_key_here
